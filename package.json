{
  "name": "@ice3/studio",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.0.0 || >=26.0.0",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "node scripts/run-latest-project.mjs",
    "dev:mini": "STUDIO_VIEWER_DIR=apps/viewer/dist cargo run --release -p studio-cli -- serve --workspace . --project wastewater-mini --fixture fixtures/wastewater-mini --native-gpu cpu",
    "benchmark": "node benchmarks/studio-mvp.mjs",
    "benchmark:prepare": "node scripts/benchmark-prepare.mjs",
    "benchmark:gpu": "node benchmarks/native-gpu.mjs",
    "benchmark:gpu-scene": "node benchmarks/gpu-scene-session.mjs",
    "benchmark:large-industrial": "node benchmarks/large-industrial-scene.mjs",
    "asset:visual-review": "node scripts/wastewater-visual-review.mjs",
    "asset:capabilities": "node scripts/wastewater-capability-report.mjs",
    "fixture:large-industrial": "node scripts/run-large-industrial-fixture.mjs",
    "verify": "node scripts/verify.mjs"
  }
}
