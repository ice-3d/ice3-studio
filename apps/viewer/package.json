{
  "name": "@ice3/studio-workbench",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^24.0.0 || >=26.0.0",
    "npm": ">=11"
  },
  "scripts": {
    "predev": "npm --prefix ../../../ice3-engine run build",
    "dev": "node esbuild.mjs --watch",
    "build": "node esbuild.mjs",
    "pretypecheck": "npm --prefix ../../../ice3-engine run build",
    "typecheck": "tsc --noEmit",
    "test": "node esbuild-tests.mjs && node --test test-dist/*.test.js",
    "pretest:e2e": "npm --prefix ../../../ice3-engine run build && STUDIO_SESSION_TOKEN=studio-e2e npm run build",
    "test:e2e": "playwright test",
    "verify": "npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "ice3": "file:../../../ice3-engine/packages/ice3",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
